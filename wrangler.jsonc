{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lst-ruta",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lst-ruta-db",
      "database_id": "f37079fe-7e2c-4b07-8573-245acca0fd96",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "lst-ruta-photos" }
  ]
}
